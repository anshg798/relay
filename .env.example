# Copy to .env (git-ignored) and fill in before `npm run generate`.
LLM_MODEL=anthropic/claude-sonnet-4-5
LLM_API_KEY=
# LLM_BASE_URL=
# Medium reasoning, as required by the task brief.
LLM_REASONING_EFFORT=medium
# Set to false when the provider has no prompt-cache quota (e.g. Gemini free tier).
LLM_CACHING_PROMPT=true
LLM_NUM_RETRIES=5
OPENHANDS_IMAGE=docker.all-hands.dev/all-hands-ai/openhands:0.59
OPENHANDS_RUNTIME_IMAGE=docker.all-hands.dev/all-hands-ai/runtime:0.59-nikolaik
